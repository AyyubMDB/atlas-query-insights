# MongoDB Atlas Programmatic API credentials (Project API Key)
# Ask your customer to create these under:
#   Atlas UI -> Project -> Project Settings -> Access Manager -> Applications -> API Keys
# Required role: "Project Read Only" at minimum.
# Add "Project Data Access Read Only" (or Project Observability Viewer) if you also
# need field-level sample query values in slow query logs.
ATLAS_PUBLIC_KEY=
ATLAS_PRIVATE_KEY=

# The Atlas Project ID (called "groupId" in the API). Found in Project Settings.
ATLAS_PROJECT_ID=

# One or more cluster names to collect insights for, comma separated
ATLAS_CLUSTER_NAMES=Cluster0

# Optional: restrict collection window. Values in milliseconds.
# duration = size of window, since = epoch ms start of window.
# Leave blank to let Atlas use its defaults (usually last 24h).
ATLAS_DURATION_MS=
ATLAS_SINCE_MS=

# Optional default filters for `npm run profile` (comma separated).
# Can also be passed as --namespaces / --op-types flags per run.
ATLAS_NAMESPACES=
ATLAS_OP_TYPES=
ATLAS_TOP_N=20

# Optional: cron schedule for `npm run profile:watch` (default every 4 hours)
COLLECT_CRON=0 */4 * * *

# Output directory for collected JSON/CSV artifacts
OUTPUT_DIR=./output

# --- Storage cluster for the local UI (server/) ---
# This is YOUR OWN MongoDB cluster (not the customer's) that the collector
# writes flattened samples into, and that the UI reads from. Use a
# dedicated database user scoped to just this one database, not an admin.
ATLAS_STORAGE_URI=
ATLAS_STORAGE_DB=atlas_query_insights
ATLAS_STORAGE_COLLECTION=slow_query_samples

# Port for `npm run ui`
UI_PORT=4000
